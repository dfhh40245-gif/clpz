# CLPZ environment variables — NAMES ONLY. Copy to .env and fill in real values.
# Never commit a real .env.

# ── Backend runtime (backend/config.py) ─────────────────────────────
# Debug mode: relaxed rate limits, /api/jobs/reset, dev code leak. MUST be 0 in production.
CLPZ_DEBUG=0
# Data directory override (desktop launcher sets this; leave unset for default ./data)
CLIPFORGE_DATA=
# Trusted proxy IPs (only these X-Forwarded-For values are honored)
CLPZ_TRUSTED_PROXIES=
# Force Secure cookie flag (set 1 behind HTTPS)
CLPZ_FORCE_SECURE_COOKIES=1
# Comma-separated CORS origins
CLPZ_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# First admin account email
CLPZ_ADMIN_EMAIL=

# ── Whisper / pipeline ──────────────────────────────────────────────
WHISPER_MODEL=tiny
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto
WHISPER_TASK=transcribe
CLIPFORGE_MODEL_DIR=
RENDER_WORKERS=1
JOB_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_JOBS=1

# ── Credits ─────────────────────────────────────────────────────────
COST_PER_FORGE=1
SIGNUP_BONUS=10

# ── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
CLPZ_FROM_EMAIL=noreply@clpz.com

# ── Public website build (frontend/config.js placeholders) ─────────
# Publishable Supabase values — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Gumroad integration (server-only; never NEXT_PUBLIC_) ───────────
# Permanent access token for license/subscription verification API
GUMROAD_ACCESS_TOKEN=
# Comma-separated Gumroad product permalinks/IDs that grant entitlements
GUMROAD_PRODUCT_IDS=
# Secret used to verify Gumroad webhook payloads
GUMROAD_WEBHOOK_SECRET=
